{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTrajectoryInterchangeFormat_v1_7",
  "description": "Standardized schema for ATIF-Gemma multi-turn developer agent execution traces (ATIF v1.7)",
  "type": "object",
  "required": ["schema_version", "agent", "steps", "final_metrics"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["ATIF-v1.7", "1.7", "v1.7"]
    },
    "agent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "model_name": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "source"],
        "properties": {
          "step_id": { "type": "integer" },
          "source": { "type": "string", "enum": ["system", "user", "agent", "tool"] },
          "message": { "type": "string" },
          "model_name": { "type": "string" },
          "llm_call_count": { "type": "integer" },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["function_name", "arguments"],
              "properties": {
                "tool_call_id": { "type": "string" },
                "function_name": { "type": "string" },
                "arguments": { "type": "object" },
                "extra": { "type": "object" }
              }
            }
          },
          "observation": {
            "type": "object",
            "properties": {
              "content": { "type": "string" },
              "extra": { "type": "object" }
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "prompt_tokens": { "type": "integer" },
              "completion_tokens": { "type": "integer" },
              "cached_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" }
            }
          },
          "extra": { "type": "object" }
        }
      }
    },
    "final_metrics": {
      "type": "object",
      "required": ["total_prompt_tokens", "total_completion_tokens", "total_tokens", "total_steps"],
      "properties": {
        "total_prompt_tokens": { "type": "integer" },
        "total_completion_tokens": { "type": "integer" },
        "total_cached_tokens": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "total_steps": { "type": "integer" }
      }
    }
  }
}
